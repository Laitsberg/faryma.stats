# ============================================================
#  ОТВЕТЧИК ДЛЯ ЧАТА СТРИМА
#  ------------------------------------------------------------
#  Нужен только Railway. GitHub Pages этот файл не замечает,
#  сайт по-прежнему собирается из статики в корне.
#
#  Зачем он вообще. Railway сам определяет, что запускать, и в этом
#  репозитории ошибался: в корне лежит index.html, поэтому сборщик
#  принимал всё за статический сайт и не находил, что стартовать.
#  С Dockerfile гадать не нужно — здесь прямо сказано, что делать.
#
#  Сборка мгновенная: боту не нужна ни одна внешняя библиотека,
#  он обходится тем, что уже есть в Node. Ставить нечего.
# ============================================================
FROM node:22-alpine

WORKDIR /app

# Берём только бота. Архив и правила разбора он скачивает с сайта
# сам, поэтому ни data.csv, ни js/ в образе не нужны — и обновление
# архива подхватывается без пересборки.
COPY bot/ ./bot/

# Railway передаёт порт в переменной окружения; наш сервер её читает
ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "bot/server.mjs"]
