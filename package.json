{
  "name": "faryma-stats",
  "version": "1.0.0",
  "private": true,
  "description": "Архив разносов farymastats.info. Сайт статический и сборки не требует — этот файл нужен только тестам.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=600000 test/*.test.mjs",
    "test:fast": "node --test --test-concurrency=1 --test-timeout=120000 test/parse.test.mjs test/archive.test.mjs test/bot.test.mjs test/chat.test.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
